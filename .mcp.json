{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "playwright-mcp",
      "args": [
        "--browser",
        "chromium",
        "--executable-path",
        "/opt/pw-browsers/chromium",
        "--headless",
        "--no-sandbox",
        "--isolated"
      ],
      "env": {}
    }
  }
}